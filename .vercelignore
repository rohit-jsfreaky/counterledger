# Upload only what the site build needs (web/ + the evidence and data it copies in). Never .env, caches or keys.
/*
!/web
!/evidence
!/data
!/program
/program/*
!/program/idl

/web/node_modules
/web/.next
/web/.env*
/web/src/generated
.env
.env.*
*-keypair.json
id.json
data/raw/*/outflows.csv.gz
data/live/*/outflows.csv
data/sources
